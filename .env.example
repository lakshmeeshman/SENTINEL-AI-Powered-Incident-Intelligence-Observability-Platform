# Optional. When set, Root Cause Analysis narratives are written by Claude,
# grounded in the evidence Sentinel's detection engine measures.
# When unset (or if the API is unreachable), Sentinel uses its built-in
# deterministic intelligence engine. The app never depends on this key.
ANTHROPIC_API_KEY=

# Optional model override.
ANTHROPIC_MODEL=claude-sonnet-5-5
