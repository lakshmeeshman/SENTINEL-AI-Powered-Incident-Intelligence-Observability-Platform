# Everything here is optional. Copy to .env.local for local development,
# or add these in your Vercel project settings.

# When set, root-cause analysis narratives are written by Claude, grounded in
# the evidence Sentinel's detection engine measures. When unset (or if the API
# is unreachable), Sentinel uses its built-in deterministic intelligence engine.
# The app never depends on this key, and it is only ever read on the server.
ANTHROPIC_API_KEY=

# Model used for narratives.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Canonical site URL for metadata (Open Graph etc.).
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
